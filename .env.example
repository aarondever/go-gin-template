# Server Configuration
SERVER_PORT=8080
SERVER_MODE=release                    # Options: debug, test, release
SERVER_READ_TIMEOUT=30s                # Timeout duration (e.g. 30s, 1m)
SERVER_WRITE_TIMEOUT=30s               # Timeout duration (e.g. 30s, 1m)

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_SSLMODE=disable                     # Options: disable, require, verify-ca, verify-full
DB_MAX_OPEN_CONNS=25                   # Maximum number of open connections
DB_MAX_IDLE_CONNS=5                    # Maximum number of idle connections
DB_CONN_MAX_LIFETIME=5m                # Connection max lifetime duration (e.g. 300s, 5m)

# Logging Configuration
LOG_LEVEL=info                         # Options: debug, info, warn, error
LOG_FORMAT=json                        # Options: text, json
